rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'sashicsm@gmail.com' ||
        request.auth.token.email == 'mixvibe069@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (
        isAdmin() ||
        isOwner(userId)
      );
      allow delete: if isAdmin();
    }

    // Admin whitelist collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Complaints collection
    match /complaints/{complaintId} {
      // Anyone can read complaints to see them on map and track
      allow get, list: if true;

      // Creation by citizen (authenticated or guest report)
      allow create: if isValidId(complaintId) &&
        incoming().keys().hasAll(['id', 'citizenId', 'title', 'category', 'status', 'lat', 'lng']) &&
        incoming().title is string && incoming().title.size() <= 200 &&
        incoming().category in ['road_damage', 'garbage_accumulation', 'water_leakage', 'streetlight_failure', 'drainage_problems', 'other_civic'] &&
        incoming().status == 'submitted' &&
        incoming().lat is number && incoming().lng is number;

      // Updates: Admins and officers can update status / assignment; Citizen can verify closure
      allow update: if (
        isAdmin() ||
        (
          // Official status transitions and proof of work by officers
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'assignedOfficerId', 'assignedOfficerName', 'proofOfWorkUrl', 'proofOfWorkNotes', 'updatedAt', 'escalated']) &&
          incoming().status in ['submitted', 'under_review', 'in_progress', 'resolved', 'verified_closed']
        ) ||
        (
          // Citizen can verify and close ticket or dispute
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
          incoming().status in ['verified_closed', 'in_progress']
        )
      );

      allow delete: if isAdmin();
    }

    // Activity logs
    match /activityLogs/{logId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(logId) &&
        incoming().keys().hasAll(['id', 'complaintId', 'action', 'timestamp']) &&
        incoming().action is string && incoming().action.size() <= 100;
      allow update, delete: if isAdmin();
    }
  }
}
